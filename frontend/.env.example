# HIME Frontend Environment Variables
# Copy this file to .env and adjust as needed.

# Backend API target for Vite dev server proxy (default: http://localhost:8000)
VITE_API_TARGET=http://localhost:8000

# API auth token — must match backend's API_AUTH_TOKEN if set.
#
# OPTIONAL, and only a convenience for local dev / native mode (hime.sh writes
# it into .env.local for you). The dashboard normally asks for the token in the
# browser on the first 401 and keeps it in sessionStorage (or localStorage if
# you tick "remember on this device"), so no rebuild is needed to change it.
#
# WARNING: anything set here is baked into dist/ at compile time and is
# therefore readable by every browser that loads the dashboard. Never set it
# for a shared or public deployment — leave it empty and use the in-browser
# prompt instead.
VITE_API_AUTH_TOKEN=

# Allowed hosts for Vite dev server (comma-separated)
VITE_ALLOWED_HOSTS=

# Base path for sub-directory deployment (default: /)
VITE_BASE_PATH=/
