# Virtual environments
venv/
env/
ENV/
.venv

# Conda
.conda/

# Environment variables
.env
.env.local

# Secrets (APNs .p8 auth keys, etc. — never commit)
secrets/
*.p8

# iOS local build configuration (Team ID, bundle prefix — never commit)
ios/hime/Config.xcconfig
ios/hime/hime.xcodeproj/xcuserdata/
ios/hime/hime.xcodeproj/project.xcworkspace/xcuserdata/

# Cloudflare Tunnel
tunnel.sh
tunnel.token
.tunnel.pid
cloudflared

# Runtime state — health DBs, agent memory, chat uploads, logs (never commit)
logs/
memory/
memory/**/*.db
ios/Server/watch*

# data/ — only bundled personalised-page assets are tracked
data/*
!data/personalised_pages/
data/personalised_pages/*
!data/personalised_pages/_shared/
!data/personalised_pages/_shared/**
# Explicit (also covered by data/*): health stores, WeChat token, iOS chat images
data/data_stores/
data/**/uploads/
data/weixin_bot_token.json
data/LiveUser/

# supported dataset (too large for git)
GLOBEM/
APPLE/
# IDE
.vscode/
.idea/
.claude/
.cursor/
*.swp
*.swo
*~
.DS_Store

# Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/

# Logs (duplicate patterns — logs/ dir is the canonical ignore)
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
_test_harness/results/

# Type checker cache
.mypy_cache/

# Documentation builds
docs/_build/

